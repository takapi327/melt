<script lang="scala">
  case class Props(initial: Int = 0)

  val count = State(props.initial)
</script>

<div class="min-h-screen flex items-center justify-center bg-slate-100">
  <div class="w-80 rounded-2xl bg-white p-8 text-center shadow-lg">
    <h1 class="mb-1 text-2xl font-bold text-slate-800">
      Melt × Tailwind — SSR
    </h1>
    <p class="mb-6 text-sm text-slate-500">
      The server SSRs the Tailwind-styled HTML; the browser hydrates it
    </p>
    <div class="mb-6 text-6xl font-black text-rose-500">
      {count}
    </div>
    <div class="flex justify-center gap-2">
      <button
        class="rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-300"
        onclick={_ => count -= 1}
      >
        −
      </button>
      <button
        class="rounded-lg bg-rose-500 px-4 py-2 font-semibold text-white hover:bg-rose-600"
        onclick={_ => count += 1}
      >
        +
      </button>
    </div>
  </div>
</div>
