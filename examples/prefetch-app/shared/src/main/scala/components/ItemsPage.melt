<script lang="scala">
import meltkit.*

// Api.items() adopts a fresh prefetch (from hovering the nav link) as Async.Done,
// so this renders with no loading flash. Without a prefetch it starts Loading and
// fetches now.
val items = Api.items()
val list  = items.state.map(_.toOption.getOrElse(Nil))
</script>

<div class="items">
  <h2>Items</h2>

  {if items.state.value.isLoading then <p class="loading">Loading…</p> else <span></span>}

  <ul>
    {list.value.map(i =>
      <li>
        <span class="name">{i.name}</span>
        <span class="blurb">{i.blurb}</span>
      </li>
    )}
  </ul>
</div>

<style>
.items h2 { margin-top: 0; }
.items ul { list-style: none; padding: 0; }
.items li { padding: 0.6rem 0; border-bottom: 1px solid #eee; }
.name { font-weight: 600; margin-right: 0.5rem; }
.blurb { color: #777; }
.loading { color: #888; font-style: italic; }
</style>
