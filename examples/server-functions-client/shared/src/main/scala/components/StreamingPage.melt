<script lang="scala">
  import meltkit.*

  // Streaming SSR: rendered with `ctx.renderStream` on the server. The shell (with
  // each boundary's <melt:pending> fallback) is flushed immediately, then each
  // resolved branch streams in as a chunk the client swaps over its fallback. The
  // two boundaries below are independent and resolve concurrently, so the faster
  // `stats` chunk arrives before the slower `posts` one (out-of-order).
  val posts = Api.streamPosts()
  val stats = Api.streamStats()
</script>

<main class="stream">
  <h1>Posts (streaming SSR)</h1>
  <p><a href="/await">← Compare with the blocking version</a></p>

  <section class="card">
    <h2>Count</h2>
    <!-- Faster boundary: streams in first. -->
    <melt:await value={stats}>
      { case Async.Done(n) => <p class="count">{n.toString} posts total</p>
        case Async.Failed(e) => <p class="error">Failed: {e.getMessage}</p> }
      <melt:pending><p class="loading">counting…</p></melt:pending>
    </melt:await>
  </section>

  <section class="card">
    <h2>Posts</h2>
    <!-- Slower boundary: its fallback shows until the chunk streams in. -->
    <melt:await value={posts}>
      { case Async.Done(list) =>
          <ul>{list.map(p =>
            <li>
              <span class="title">{p.title}</span>
              <span class="likes">♥ {p.likes.toString}</span>
            </li>
          )}</ul>
        case Async.Failed(e) =>
          <p class="error">Failed to load: {e.getMessage}</p> }
      <melt:pending><p class="loading">Loading posts…</p></melt:pending>
    </melt:await>
  </section>
</main>

<style>
  .stream {
    max-width: 32rem;
    margin: 3rem auto;
    font-family: system-ui, sans-serif;
  }

  .card {
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1rem 0;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    color: #555;
  }

  .stream ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stream li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #eee;
  }

  .title {
    flex: 1;
  }

  .likes {
    color: #c0392b;
    min-width: 3rem;
  }

  .error,
  .loading {
    color: #666;
  }
</style>
