<script lang="scala">
  case class Props(city: City)
</script>

<div class="page">
  <p><a class="back" href="/">← All cities</a></p>

  <h1>{props.city.name}</h1>

  <dl>
    <dt>Country</dt>
    <dd>{props.city.countryCode}</dd>

    <dt>District</dt>
    <dd>{props.city.district}</dd>

    <dt>Population</dt>
    <!-- Arithmetic on a DB-derived column: only compiles while `population` is numeric. -->
    <dd>{props.city.population} ({props.city.population / 1000}k)</dd>
  </dl>
</div>

