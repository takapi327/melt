<script lang="scala">
  case class Props(greeting: String = "", visitors: Int = 0)

  val count = State(0)
</script>

<main class="page">
  <div class="card">
    <h1>
      {props.greeting}
    </h1>
    <p class="hint">
      Rendered on the server by zio-http, hydrated in the browser. The greeting and the visitor count came from a <code>ZLayer</code> service, read inside the route handler with <code>ZIO.serviceWithZIO</code>.
    </p>
    <p class="visitors">
      Visitor #{props.visitors}
    </p>
    <div class="counter">
      <button onclick={_ => count -= 1}>
        −
      </button>
      <span class="value">
        {count}
      </span>
      <button class="primary" onclick={_ => count += 1}>
        +
      </button>
    </div>
  </div>
</main>

